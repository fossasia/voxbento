HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-me
# Keep debug disabled by default: no SQL echo or debug error pages.
# Local debugging only: explicitly set DEBUG=true in your own .env.
# With DEBUG=false, configure strong secrets before starting (see CONTRIBUTING.md).
DEBUG=false
# [CRITICAL] 32-character minimum string for encrypting API keys at rest.
# To rotate keys, provide a comma-separated list. The first key is used for encryption,
# all keys are used for decryption.
API_KEY_ENCRYPTION_KEY=your-secure-32-char-key-here
BOOTH_ACCESS_TOKEN=

# Signup protection: existing deployments do not require Turnstile keys until enabled.
# Create a Managed widget for the PUBLIC_BASE_URL hostname, then set both keys.
# See docs/registration-protection.md for rollout and trusted-proxy requirements.
REGISTRATION_TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REGISTRATION_REQUESTS_PER_MINUTE=20

# JWT settings — leave JWT_SECRET empty to fall back to SECRET_KEY
JWT_SECRET=
JWT_EXPIRY_SECONDS=86400

# ── Jitsi Meet ────────────────────────────────────────────────────────────────
# Self-hosted Jitsi runs in Docker alongside the portal.
# Local dev: use http://localhost:8080 (Jitsi HTTP port)
# Production (voxbento.com): Caddy proxies jitsi.voxbento.com → JITSI_DOMAIN=jitsi.voxbento.com
# Leave empty for local dev — defaults to http://{JITSI_DOMAIN}
# For HTTPS production: JITSI_BASE_URL=https://jitsi.your-domain.com
JITSI_BASE_URL=https://jitsi.voxbento.com
DEFAULT_JITSI_ROOM=eventyay-stage-room
JITSI_DOMAIN=localhost:8080

# Jitsi internal auth (change in production — use long random passwords)
JVB_AUTH_PASSWORD=changeme
JICOFO_AUTH_PASSWORD=changeme

# JVB_ADVERTISE_IPS — required for Jitsi JVB WebRTC ICE.
# Set to your server's public IP so WebRTC ICE candidates are reachable.
# macOS:  ipconfig getifaddr en0
# Linux:  hostname -I | awk '{print $1}'
JVB_ADVERTISE_IPS=

# ── MediaMTX — WebRTC/WHIP ingest + WHEP playback ─────────────────────────────
# These are the URLs the BROWSER uses (must be reachable from outside Docker).
#
# Local dev:
#   MEDIAMTX_WHIP_BASE=http://localhost:8889
#
# Production (voxbento.com) — Caddy proxies:
#   */{path}/whip   → localhost:8889  (WHIP ingest)
#   */{path}/whep   → localhost:8889  (WHEP playback)
#
#   MEDIAMTX_WHIP_BASE=https://voxbento.com
#
MEDIAMTX_WHIP_BASE=http://localhost:8889

# Floor Bot & Internal Routing — captures Jitsi conference audio for floor transcription
# The base URL the backend uses to send start/stop commands to the floor-bot container.
FLOOR_BOT_BASE=http://floor-bot:8080
# Managed meeting agent recovery (see docs/meeting-source.md)
# MEETING_AGENT_MAX_RESTARTS=5
# MEETING_AGENT_NO_AUDIO_SECS=45

# The internal RTSP base URL used by the ffmpeg transcription worker to pull audio from MediaMTX.
MEDIAMTX_RTSP_BASE=rtsp://mediamtx:8554

# Required outside DEBUG mode. Shared only by MediaMTX and the portal's private
# publish-authorization hook. Generate with: openssl rand -hex 32
MEDIAMTX_AUTH_HOOK_SECRET=

# RTMPS ingest + YouTube relay (#749) — only with docker-compose.relay.yml; see docs/program-relay.md.
# PROGRAM_RELAY_CONTROL_SECRET=          # openssl rand -hex 32; shared by portal and program-relay
# PROGRAM_RTMPS_PUBLIC_BASE=rtmps://voxbento.com:1936
# PROGRAM_RTMPS_CERT_DIR=/etc/voxbento/rtmps   # rtmps.crt + rtmps.key for that hostname
# PROGRAM_RELAY_MAX=4
# PROGRAM_RELAY_ALLOWED_HOSTS=a.rtmps.youtube.com,b.rtmps.youtube.com

# (Optional) Internal Jitsi URL used by the backend to bypass WebRTC HTTP origin blocks.
# If Jitsi is deployed externally (not in docker-compose), set this to its public URL.
# Defaults to effective JITSI_BASE_URL if not set.
# JITSI_INTERNAL_BASE=https://jitsi-web:8443

# Database URL — select ONE option below based on your setup:
#
# [Docker Compose] Leave DATABASE_URL UNSET (keep it commented out).
#   docker-compose.yml already defaults to:
#     sqlite+aiosqlite:////data/interpretation.db  (on a named Docker volume)
#   Setting a local ./path here overrides that default and causes SQLite
#   disk I/O errors on Docker for Windows/Mac due to bind-mount file
#   locking limitations — this will crash the portal container on startup.
#
# [Native local dev] Uncomment to store the DB in the project root:
# DATABASE_URL=sqlite+aiosqlite:///./interpretation.db
#
# [PostgreSQL / production]:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/interpretation

# ── NVIDIA Riva (optional transcription provider) ────────────────────────────
# Required only when using the 'nvidia' transcription provider.
# NVIDIA_FUNCTION_ID=<your-nvidia-cloud-function-id>

# ── Email / SMTP (optional) ──────────────────────────────────────────────────
# Leave SMTP_HOST empty to run without sending email.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PORT=587
# SMTP_FROM_EMAIL=noreply@voxbento.com
